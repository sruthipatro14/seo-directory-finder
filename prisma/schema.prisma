generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DaCategory {
  Low
  Average
  Excellent
}

model Website {
  id              String     @id @default(cuid())
  name            String
  url             String     @unique
  domainAuthority Int        @default(0)
  spamScore       Int        @default(0)
  freeListing     Boolean    @default(false)
  industry        String
  daCategory      DaCategory @default(Low)
  active          Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([industry])
  @@index([daCategory])
}

model SearchHistory {
  id        String   @id @default(cuid())
  keyword   String
  createdAt DateTime @default(now())

  @@index([keyword])
}